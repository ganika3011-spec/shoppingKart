# Django Settings
DEBUG=False
SECRET_KEY=your-very-secure-and-random-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,shoppingkart-rdlq.onrender.com

# === RENDER.COM SPECIFIC ===
RENDER=True

# Database Configuration - PostgreSQL (recommended for production)
# For local SQLite: DATABASE_URL=sqlite:///db.sqlite3
# For Render PostgreSQL: Get from PostgreSQL resource → Info tab → Internal Database URL
DATABASE_URL=postgresql://user:password@dpg-xxx:5432/shopping_cart

# Email Configuration (Gmail SMTP - Used for registration, password reset, etc.)
# Get Gmail App Password from: https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@gmail.com

# AWS S3 Configuration (for media/static files in production)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Logging
LOG_LEVEL=INFO

# Cache Configuration
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://127.0.0.1:6379/1

# Pagination
ITEMS_PER_PAGE=12
